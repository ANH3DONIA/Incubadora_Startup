{
  "name": "incubator-quick-pitch",
  "version": "1.0.0",
  "description": "Plataforma de Incubadora de Startups con Quick Pitches en vivo y Marketplace",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run start --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run prisma:generate --workspace=backend && npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run prisma:generate --workspace=backend && npm run build --workspace=backend",
    "test": "npm run test --workspace=backend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:studio": "npm run prisma:studio --workspace=backend"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {}
}
