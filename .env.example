# ==========================================
# BASE DE DATOS Y CACHÉ (PostgreSQL & Redis)
# ==========================================
DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/incubator_db?schema=public"
REDIS_URL="redis://localhost:6379"

# ==========================================
# BACKEND API (Express 5 + TypeScript)
# ==========================================
PORT=3001
JWT_ACCESS_SECRET="dev-jwt-access-secret-key-32-chars-long-min"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-key-32-chars-long-min"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
# Clave AES-256 para cifrado de Pitch Decks (exactamente 32 caracteres)
ENCRYPTION_KEY="12345678901234567890123456789012"
CORS_ORIGIN="http://localhost:3000"

# ==========================================
# ALMACENAMIENTO (MinIO / S3)
# ==========================================
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="adminpassword123"
MINIO_BUCKET_NAME="pitch-decks"

# ==========================================
# PAGOS (Stripe)
# ==========================================
STRIPE_SECRET_KEY="sk_test_mock_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_secret_key"
STRIPE_SUCCESS_URL="http://localhost:3000/dashboard"
STRIPE_CANCEL_URL="http://localhost:3000/pricing"

# ==========================================
# PAGOS CRIPTO (Binance Pay)
# ==========================================
BINANCE_MERCHANT_ID="mock_merchant_id"
BINANCE_API_KEY="mock_binance_api_key"
BINANCE_SECRET_KEY="mock_binance_secret_key"

# ==========================================
# CALENDARIOS (OAuth)
# ==========================================
GOOGLE_CLIENT_ID="mock_google_client_id"
GOOGLE_CLIENT_SECRET="mock_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"

OUTLOOK_CLIENT_ID="mock_outlook_client_id"
OUTLOOK_CLIENT_SECRET="mock_outlook_client_secret"
OUTLOOK_REDIRECT_URI="http://localhost:3001/api/calendar/outlook/callback"

# ==========================================
# FRONTEND (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
