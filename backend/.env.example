# ==============================================================================
# NEXUS VENTURES INCUBATOR - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incubator_db?schema=public"

# Authentication & JWT Session Secrets (Min 32 characters)
JWT_ACCESS_SECRET="super_secret_jwt_access_key_min_32_chars_long_123456"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_min_32_chars_long_123456"

# End-to-End Cryptography (AES-256-GCM - exactly 32 bytes/characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# Redis Cache & WebSockets Adapter
REDIS_URL="redis://localhost:6379"

# Stripe Gateway (Fiat & Subscriptions)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Binance Pay (Crypto USDT Settlements)
BINANCE_API_KEY="your_binance_api_key"
BINANCE_SECRET_KEY="your_binance_secret_key"
BINANCE_MERCHANT_ID="your_binance_merchant_id"
